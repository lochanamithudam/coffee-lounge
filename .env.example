# ============================================================
# Coffee Lounge - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git!
# ============================================================

# Server Port
PORT=5000

# Gmail Email (for sending confirmation emails)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/CoffeeLoungeDB?retryWrites=true&w=majority

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=https://your-project.vercel.app

# Secret Admin API Key (used to authorize GET /api/orders, /api/reservations, /api/newsletter)
ADMIN_API_KEY=coffee_lounge_admin_secret_2026

